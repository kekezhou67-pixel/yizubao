# ============================================================
# 构建镜像时排除的文件
# 作用：减小上下文体积 + 防止敏感信息进入镜像
# ============================================================

# ---------- 构建产物（容器里会重新编译）----------
target/
build/
out/
*.jar
*.war

# ---------- IDE ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ---------- Git ----------
.git/
.gitignore
.gitattributes

# ---------- ★ 敏感文件（最关键）----------
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.jks

# ---------- 日志 ----------
logs/
*.log

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- 文档 ----------
*.md
README*
docs/

# ---------- 测试 ----------
src/test/