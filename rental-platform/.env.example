# =============================================
# 智能租房平台 —— 环境变量模板
# 复制此文件为 .env 并填入真实值
# .env 已加入 .gitignore，不会提交到 Git
# =============================================

# === 数据库 ===
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# === JWT ===
JWT_SECRET=your_jwt_secret_at_least_32_chars

# === DeepSeek AI（留空则不启用 AI 功能） ===
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_TIMEOUT=60

# === 阿里云短信（留空则验证码打印到控制台） ===
ALIYUN_SMS_ACCESS_KEY=your_aliyun_access_key
ALIYUN_SMS_SECRET=your_aliyun_secret
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE=100001
ALIYUN_SMS_REGION=cn-hangzhou

# === 服务器 ===
SERVER_PORT=8080
